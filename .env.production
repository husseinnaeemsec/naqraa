# ===========================================
# Naqraa Frontend - Production Environment
# ===========================================

# Environment Configuration
VITE_NODE_ENV=production
VITE_APP_NAME=Naqraa
VITE_APP_VERSION=1.0.0

# API Configuration
VITE_API_URL=https://api.naqraa.com/api
VITE_API_TIMEOUT=30000
VITE_API_RETRY_ATTEMPTS=3

# Authentication
VITE_AUTH_TOKEN_KEY=access_token
VITE_AUTH_REFRESH_KEY=refresh_token
VITE_AUTH_SESSION_TIMEOUT=3600000

# Feature Flags (Production ready features only)
VITE_ENABLE_CHAT=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_PWA=true
VITE_ENABLE_ANALYTICS=true

# UI Configuration
VITE_DEFAULT_LANGUAGE=ar
VITE_SUPPORTED_LANGUAGES=ar,en,ku
VITE_RTL_LANGUAGES=ar,ku
VITE_PAGINATION_SIZE=12
VITE_DEBOUNCE_MS=300

# File Upload
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=pdf,doc,docx,ppt,pptx,jpg,jpeg,png,gif

# External Services (Production credentials)
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
VITE_INTERCOM_APP_ID=your-intercom-app-id

# Development Tools (Disabled for production)
VITE_ENABLE_DEV_TOOLS=false
VITE_ENABLE_REDUX_DEVTOOLS=false
VITE_LOG_LEVEL=error

# CDN & Assets
VITE_CDN_URL=https://cdn.naqraa.com
VITE_STATIC_URL=https://static.naqraa.com/

# Social Auth
VITE_GOOGLE_CLIENT_ID=production-google-client-id
VITE_FACEBOOK_APP_ID=production-facebook-app-id

# Email Configuration
VITE_SUPPORT_EMAIL=support@naqraa.com
VITE_CONTACT_EMAIL=contact@naqraa.com

# App Store Links
VITE_APP_STORE_URL=https://apps.apple.com/app/naqraa
VITE_GOOGLE_PLAY_URL=https://play.google.com/store/apps/details?id=com.naqraa

# WebSocket Configuration
VITE_WS_URL=wss://api.naqraa.com/ws
VITE_WS_RECONNECT_INTERVAL=5000

# Security
VITE_ENABLE_CSP=true
VITE_ALLOWED_HOSTS=naqraa.com,www.naqraa.com,api.naqraa.com

# Performance
VITE_ENABLE_BUNDLE_ANALYZER=false
VITE_ENABLE_COMPRESSION=true