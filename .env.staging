# ===========================================
# Naqraa Frontend - Staging Environment
# ===========================================

# Environment Configuration
VITE_NODE_ENV=staging
VITE_APP_NAME=Naqraa Staging
VITE_APP_VERSION=1.0.0-staging

# API Configuration
VITE_API_URL=https://api-staging.naqraa.com/api
VITE_API_TIMEOUT=30000
VITE_API_RETRY_ATTEMPTS=3

# Authentication
VITE_AUTH_TOKEN_KEY=access_token
VITE_AUTH_REFRESH_KEY=refresh_token
VITE_AUTH_SESSION_TIMEOUT=3600000

# Feature Flags (Most enabled for staging testing)
VITE_ENABLE_CHAT=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_PWA=true
VITE_ENABLE_ANALYTICS=false

# UI Configuration
VITE_DEFAULT_LANGUAGE=ar
VITE_SUPPORTED_LANGUAGES=ar,en,ku
VITE_RTL_LANGUAGES=ar,ku
VITE_PAGINATION_SIZE=12
VITE_DEBOUNCE_MS=300

# File Upload
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=pdf,doc,docx,ppt,pptx,jpg,jpeg,png,gif

# External Services (Staging credentials)
VITE_GOOGLE_ANALYTICS_ID=
VITE_SENTRY_DSN=
VITE_INTERCOM_APP_ID=

# Development Tools (Limited for staging)
VITE_ENABLE_DEV_TOOLS=false
VITE_ENABLE_REDUX_DEVTOOLS=false
VITE_LOG_LEVEL=warn

# CDN & Assets
VITE_CDN_URL=https://cdn-staging.naqraa.com
VITE_STATIC_URL=https://static-staging.naqraa.com/

# Social Auth
VITE_GOOGLE_CLIENT_ID=staging-google-client-id
VITE_FACEBOOK_APP_ID=staging-facebook-app-id

# Email Configuration
VITE_SUPPORT_EMAIL=staging-support@naqraa.com
VITE_CONTACT_EMAIL=staging-contact@naqraa.com

# App Store Links
VITE_APP_STORE_URL=
VITE_GOOGLE_PLAY_URL=

# WebSocket Configuration
VITE_WS_URL=wss://api-staging.naqraa.com/ws
VITE_WS_RECONNECT_INTERVAL=5000

# Security
VITE_ENABLE_CSP=true
VITE_ALLOWED_HOSTS=staging.naqraa.com,api-staging.naqraa.com

# Performance
VITE_ENABLE_BUNDLE_ANALYZER=false
VITE_ENABLE_COMPRESSION=true