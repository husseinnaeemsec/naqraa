# ===========================================
# Naqraa Frontend - Development Environment
# ===========================================

# Allowed hosts 
VITE_ALLOWED_HOSTS=localhost,127.0.0.1
VITE_HOST=localhost
VITE_BASE_URL=http://localhost/
VITE_BASE_API_URL=http://0.0.0.0:8000/api
VITE_TRUSTED_HOSTS=localhost,127.0.0.1


# Environment Configuration
VITE_NODE_ENV=development
VITE_APP_NAME=Naqraa Dev
VITE_APP_VERSION=1.0.0-dev

# API Configuration
VITE_API_URL=http://localhost:8000/api
VITE_API_TIMEOUT=30000
VITE_API_RETRY_ATTEMPTS=3

# Authentication
VITE_AUTH_TOKEN_KEY=access_token
VITE_AUTH_REFRESH_KEY=refresh_token
VITE_AUTH_SESSION_TIMEOUT=3600000

# Feature Flags (All enabled for development)
VITE_ENABLE_CHAT=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_PWA=false
VITE_ENABLE_ANALYTICS=false

# UI Configuration
VITE_DEFAULT_LANGUAGE=ar
VITE_SUPPORTED_LANGUAGES=ar,en,ku
VITE_RTL_LANGUAGES=ar,ku
VITE_PAGINATION_SIZE=12
VITE_DEBOUNCE_MS=300

# File Upload
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=pdf,doc,docx,ppt,pptx,jpg,jpeg,png,gif

# External Services (Empty for development)
VITE_GOOGLE_ANALYTICS_ID=
VITE_SENTRY_DSN=
VITE_INTERCOM_APP_ID=

# Development Tools (Enabled for development)
VITE_ENABLE_DEV_TOOLS=true
VITE_ENABLE_REDUX_DEVTOOLS=true
VITE_LOG_LEVEL=debug

# CDN & Assets
VITE_CDN_URL=
VITE_STATIC_URL=/

# Social Auth (Development - use test credentials)
VITE_GOOGLE_CLIENT_ID=
VITE_FACEBOOK_APP_ID=

# Email Configuration
VITE_SUPPORT_EMAIL=dev-support@naqraa.com
VITE_CONTACT_EMAIL=dev-contact@naqraa.com

# App Store Links
VITE_APP_STORE_URL=
VITE_GOOGLE_PLAY_URL=

# WebSocket Configuration
VITE_WS_URL=ws://localhost:8000/ws
VITE_WS_RECONNECT_INTERVAL=5000

# Security
VITE_ENABLE_CSP=false
VITE_ALLOWED_HOSTS=localhost,127.0.0.1,naqraa

# Performance
VITE_ENABLE_BUNDLE_ANALYZER=false
VITE_ENABLE_COMPRESSION=false

# VAPID
VITE_VAPID_PUBLIC_KEY=BKBqLHq78vADus1WZXiTDwXz-79jpRzjpINFHxLY4n93sJOLtIS17cv_Ge6xuPfcJTxZBsBscvnzpGzYKkdawbU

# WS 
VITE_WS_HOST=ws://localhost:8000/ws

# Exclude from paths from authentication check 

VITE_EXCLUDE_AUTH_CHECK=/login,/register